<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RevitEtabsValidator</RootNamespace>
    <AssemblyName>RevitEtabsValidator</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Revit 2025 ↔ ETABS Structural Model Validator</AssemblyTitle>
    <Description>Structural model coordination validator for Revit 2025 and ETABS</Description>
    <Company>Structural Automation</Company>
    <Product>RevitEtabsValidator</Product>
    <Version>1.0.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <StartAction>Program</StartAction>
    <StartProgram>$(RevitInstallPath)\Revit.exe</StartProgram>
  </PropertyGroup>

  <PropertyGroup>
    <RevitInstallPath Condition="'$(RevitInstallPath)'==''">$(ProgramFiles)\Autodesk\Revit 2025</RevitInstallPath>
    <EtabsInstallPath Condition="Exists('$(ProgramFiles)\Computers and Structures\ETABS 22')">$(ProgramFiles)\Computers and Structures\ETABS 22</EtabsInstallPath>
    <EtabsInstallPath Condition="'$(EtabsInstallPath)'=='' And Exists('$(ProgramFiles(x86))\Computers and Structures\ETABS 22')">$(ProgramFiles(x86))\Computers and Structures\ETABS 22</EtabsInstallPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ETABSv1">
      <HintPath>$(EtabsInstallPath)\ETABSv1.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
    <Compile Include="ETABS\**\*.cs" />
    <Compile Include="Revit\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="Revit\UI\*.xaml" />
  </ItemGroup>

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>
</Project>
