<Window x:Class="RevitEtabsValidator.Revit.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Revit ↔ ETABS Structural Model Validator" Height="820" Width="1380" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
<Grid Margin="12">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
<Button Content="Read Revit" Width="110" Margin="0,0,6,0" Click="ReadRevit_Click"/><Button Content="Connect ETABS" Width="120" Margin="0,0,6,0" Click="ConnectEtabs_Click"/><CheckBox x:Name="StartEtabs" Content="Start ETABS if not running" VerticalAlignment="Center" IsChecked="False" Margin="0,0,14,0"/><Button Content="Run Validation" Width="120" Margin="0,0,6,0" Click="RunValidation_Click"/><Button Content="Export CSV" Width="100" Margin="0,0,6,0" Click="ExportCsv_Click"/><Button Content="Export JSON" Width="100" Click="ExportJson_Click"/>
</StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="Position ±" VerticalAlignment="Center"/><TextBox x:Name="PositionTol" Text="25" Width="55" Margin="4,0,10,0"/><TextBlock Text="Elevation ±" VerticalAlignment="Center"/><TextBox x:Name="ElevationTol" Text="25" Width="55" Margin="4,0,10,0"/><TextBlock Text="Section ±" VerticalAlignment="Center"/><TextBox x:Name="SectionTol" Text="5" Width="55" Margin="4,0,10,0"/><TextBlock Text="Length ±" VerticalAlignment="Center"/><TextBox x:Name="LengthTol" Text="25" Width="55" Margin="4,0,10,0"/><TextBlock Text="Angle ±" VerticalAlignment="Center"/><TextBox x:Name="AngleTol" Text="1" Width="55" Margin="4,0,10,0"/><TextBlock Text="mm / deg" VerticalAlignment="Center" Foreground="Gray"/></StackPanel>
<UniformGrid Grid.Row="2" Columns="8" Margin="0,0,0,8"><Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Revit Columns" FontWeight="Bold"/><TextBlock x:Name="RevitColCount" Text="0" FontSize="20"/></StackPanel></Border><Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="ETABS Columns" FontWeight="Bold"/><TextBlock x:Name="EtabsColCount" Text="0" FontSize="20"/></StackPanel></Border><Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Revit Beams" FontWeight="Bold"/><TextBlock x:Name="RevitBeamCount" Text="0" FontSize="20"/></StackPanel></Border><Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="ETABS Beams" FontWeight="Bold"/><TextBlock x:Name="EtabsBeamCount" Text="0" FontSize="20"/></StackPanel></Border><Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Matched" FontWeight="Bold"/><TextBlock x:Name="MatchedCount" Text="0" FontSize="20"/></StackPanel></Border><Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Warnings" FontWeight="Bold"/><TextBlock x:Name="WarningCount" Text="0" FontSize="20"/></StackPanel></Border><Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Errors" FontWeight="Bold"/><TextBlock x:Name="ErrorCount" Text="0" FontSize="20"/></StackPanel></Border><Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Missing" FontWeight="Bold"/><TextBlock x:Name="MissingCount" Text="0" FontSize="20"/></StackPanel></Border></UniformGrid>
<TabControl Grid.Row="3"><TabItem Header="Results"><Grid Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="Filter:" VerticalAlignment="Center"/><ComboBox x:Name="FilterBox" Width="150" Margin="6,0,10,0" SelectionChanged="FilterBox_SelectionChanged"><ComboBoxItem Content="All" IsSelected="True"/><ComboBoxItem Content="Matched"/><ComboBoxItem Content="Warnings"/><ComboBoxItem Content="Errors"/><ComboBoxItem Content="Missing"/></ComboBox><ComboBox x:Name="FloorBox" Width="160" Margin="0,0,10,0" SelectionChanged="FloorBox_SelectionChanged"/><Button Content="Select in Revit" Width="110" Click="SelectInRevit_Click"/></StackPanel><DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ResultsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding ElementType}" Width="70"/><DataGridTextColumn Header="Level" Binding="{Binding StoryOrLevel}" Width="120"/><DataGridTextColumn Header="Revit" Binding="{Binding RevitName}" Width="150"/><DataGridTextColumn Header="ETABS" Binding="{Binding EtabsName}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn Header="ΔPos (mm)" Binding="{Binding PositionDeltaMm,StringFormat=F1}" Width="90"/><DataGridTextColumn Header="ΔElev (mm)" Binding="{Binding ElevationDeltaMm,StringFormat=F1}" Width="90"/><DataGridTextColumn Header="ΔW (mm)" Binding="{Binding WidthDeltaMm,StringFormat=F1}" Width="75"/><DataGridTextColumn Header="ΔD (mm)" Binding="{Binding DepthDeltaMm,StringFormat=F1}" Width="75"/><DataGridTextColumn Header="ΔL (mm)" Binding="{Binding LengthDeltaMm,StringFormat=F1}" Width="75"/><DataGridTextColumn Header="ΔRot (°)" Binding="{Binding RotationDeltaDeg,StringFormat=F1}" Width="75"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence,StringFormat=F0}" Width="80"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Floor Plan"><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Level" FontWeight="Bold"/><ComboBox x:Name="PlanFloorBox" SelectionChanged="PlanFloorBox_SelectionChanged" Margin="0,4,0,10"/><TextBlock Text="Legend" FontWeight="Bold"/><TextBlock Text="Revit members: solid gray" Margin="0,5,0,0"/><TextBlock Text="ETABS members: dashed gray"/><TextBlock Text="Mismatch / missing: highlighted"/><TextBlock Text="Click a result row to focus the same level." TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel><Border Grid.Column="1" BorderBrush="DarkGray" BorderThickness="1" Background="White"><Canvas x:Name="PlanCanvas" Margin="10"/></Border></Grid></TabItem><TabItem Header="Selected Difference"><ScrollViewer Margin="8"><TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" FontFamily="Consolas"/></ScrollViewer></TabItem></TabControl>
<TextBlock Grid.Row="4" x:Name="StatusText" Text="Ready." Margin="0,8,0,0" Foreground="DarkSlateGray"/>
</Grid></Window>
