<Window x:Class="RevitEtabsValidator.Revit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit ↔ ETABS Structural Model Validator"
        Height="920" Width="1500" MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#F4F6F8" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Revit ↔ ETABS Structural Model Validator" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Advanced structural coordination — Internal Origin ↔ ETABS Global" Foreground="DimGray" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="White" BorderBrush="#D5D9DE" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="SeaGreen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ConnectionStateText" Text="ETABS: Not connected" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Read Revit" Width="110" Height="30" Margin="0,0,6,0" Click="ReadRevit_Click"/>
            <Button Content="Connect ETABS" Width="125" Height="30" Margin="0,0,6,0" Click="ConnectEtabs_Click"/>
            <CheckBox x:Name="StartEtabs" Content="Start ETABS if not running" VerticalAlignment="Center" IsChecked="False" Margin="0,0,16,0"/>
            <Button Content="Run Validation" Width="125" Height="30" Margin="0,0,6,0" Click="RunValidation_Click"/>
            <Button Content="Validation Scope…" Width="125" Height="30" Margin="0,0,6,0" Click="SelectFloors_Click"/>
            <Button Content="Export CSV" Width="100" Height="30" Margin="12,0,6,0" Click="ExportCsv_Click"/>
            <Button Content="Export JSON" Width="105" Height="30" Click="ExportJson_Click"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Position ±" VerticalAlignment="Center"/>
                <TextBox x:Name="PositionTol" Text="25" Width="55" Grid.Column="1" Margin="4,0,12,0"/>
                <TextBlock Text="Elevation ±" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="ElevationTol" Text="25" Width="55" Grid.Column="3" Margin="4,0,12,0"/>
                <TextBlock Text="Section ±" Grid.Column="4" VerticalAlignment="Center"/>
                <TextBox x:Name="SectionTol" Text="5" Width="55" Grid.Column="5" Margin="4,0,12,0"/>
                <TextBlock Text="Length ±" Grid.Column="6" VerticalAlignment="Center"/>
                <TextBox x:Name="LengthTol" Text="25" Width="55" Grid.Column="7" Margin="4,0,12,0"/>
                <TextBlock Text="Angle ±" Grid.Column="8" VerticalAlignment="Center"/>
                <TextBox x:Name="AngleTol" Text="1" Width="55" Grid.Column="9" Margin="4,0,12,0"/>
                <TextBlock Text="mm / deg" Grid.Column="10" Foreground="Gray" VerticalAlignment="Center"/>
                <Border Grid.Column="11" Background="#F7F9FA" BorderBrush="#D5D9DE" BorderThickness="1" CornerRadius="5" Padding="10,5">
                    <TextBlock x:Name="ScopeText" Text="Scope: all floors" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="3" Rows="1" Columns="8" Margin="0,0,0,8">
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Revit Columns" FontWeight="Bold"/><TextBlock x:Name="RevitColCount" Text="0" FontSize="20"/></StackPanel></Border>
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="ETABS Columns" FontWeight="Bold"/><TextBlock x:Name="EtabsColCount" Text="0" FontSize="20"/></StackPanel></Border>
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Revit Beams" FontWeight="Bold"/><TextBlock x:Name="RevitBeamCount" Text="0" FontSize="20"/></StackPanel></Border>
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="ETABS Beams" FontWeight="Bold"/><TextBlock x:Name="EtabsBeamCount" Text="0" FontSize="20"/></StackPanel></Border>
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Matched" FontWeight="Bold"/><TextBlock x:Name="MatchedCount" Text="0" FontSize="20"/></StackPanel></Border>
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Warnings" FontWeight="Bold"/><TextBlock x:Name="WarningCount" Text="0" FontSize="20"/></StackPanel></Border>
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Errors" FontWeight="Bold"/><TextBlock x:Name="ErrorCount" Text="0" FontSize="20"/></StackPanel></Border>
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="Missing" FontWeight="Bold"/><TextBlock x:Name="MissingCount" Text="0" FontSize="20"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border BorderBrush="#D8DDE2" BorderThickness="1" CornerRadius="6" Padding="10" Grid.Column="0" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Floor Plans" FontSize="17" FontWeight="SemiBold"/>
                    <ListBox x:Name="PlanFloorList" Grid.Row="1" Margin="0,8,0,8" SelectionChanged="PlanFloorList_SelectionChanged"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="All" Width="65" Margin="0,0,5,0" Click="AllFloors_Click"/>
                        <Button Content="Scope…" Width="75" Margin="0,0,5,0" Click="SelectFloors_Click"/>
                        <Button Content="Clear" Width="65" Click="ClearFloorView_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#BFC6CE" BorderThickness="1" CornerRadius="6" Background="White" ClipToBounds="True" x:Name="PlanViewHost">
                <Grid>
                    <Border Background="#F7F9FA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,5" CornerRadius="4" Panel.ZIndex="5">
                        <TextBlock Text="Wheel: zoom   •   Middle mouse: pan   •   Click member: details" Foreground="#4B5563"/>
                    </Border>
                    <Canvas x:Name="PlanCanvas" Background="Transparent" MouseWheel="PlanCanvas_MouseWheel" MouseDown="PlanCanvas_MouseDown" MouseMove="PlanCanvas_MouseMove" MouseUp="PlanCanvas_MouseUp" SizeChanged="PlanCanvas_SizeChanged"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Panel.ZIndex="5">
                        <Button Content="Fit" Width="55" Height="28" Margin="0,0,5,0" Click="FitPlan_Click"/>
                        <Button Content="−" Width="35" Height="28" Margin="0,0,5,0" Click="ZoomOut_Click"/>
                        <Button Content="+" Width="35" Height="28" Margin="0,0,5,0" Click="ZoomIn_Click"/>
                        <Border Background="White" BorderBrush="#D5D9DE" BorderThickness="1" Padding="8,4" CornerRadius="4"><TextBlock x:Name="ZoomText" Text="100%"/></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Panel.ZIndex="5">
                        <Border Background="White" BorderBrush="#D5D9DE" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,5,0"><TextBlock><Run Text="Revit" FontWeight="Bold"/><Run Text="  ━"/></TextBlock></Border>
                        <Border Background="White" BorderBrush="#D5D9DE" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,5,0"><TextBlock><Run Text="ETABS" FontWeight="Bold"/><Run Text="  ┄"/></TextBlock></Border>
                        <Border Background="White" BorderBrush="#D5D9DE" BorderThickness="1" CornerRadius="4" Padding="8"><TextBlock><Run Text="Mismatch" FontWeight="Bold"/><Run Text="  red"/></TextBlock></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D8DDE2" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected Member" FontSize="17" FontWeight="SemiBold"/>
                        <Border Background="#F7F9FA" BorderBrush="#DDE2E7" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,8,0,10"><StackPanel><TextBlock x:Name="SelectedTypeText" Text="—" FontWeight="Bold"/><TextBlock x:Name="SelectedStatusText" Text="No member selected" Margin="0,3,0,0"/></StackPanel></Border>
                        <TextBlock Text="Correspondence" FontWeight="Bold" Margin="0,2,0,5"/>
                        <TextBlock x:Name="SelectedRevitText" Text="Revit: —" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedEtabsText" Text="ETABS: —" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Section" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedSectionText" Text="Revit: —&#x0a;ETABS: —" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="Location" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="SelectedLocationText" Text="Revit: —&#x0a;ETABS: —" TextWrapping="Wrap" Margin="0,3,0,0" FontFamily="Consolas"/>
                        <TextBlock Text="Differences" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="SelectedDeltaText" Text="—" TextWrapping="Wrap" Margin="0,3,0,0" FontFamily="Consolas"/>
                        <TextBlock Text="Why?" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="SelectedReasonText" Text="Select a beam or column in the plan." TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0"><Button Content="Open Details" Width="105" Height="30" Margin="0,0,6,0" Click="OpenDetails_Click"/><Button Content="Select in Revit" Width="110" Height="30" Click="SelectInRevit_Click"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="5" BorderBrush="#D8DDE2" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="8,6"><TextBlock Text="Current Floor Results" FontWeight="SemiBold"/><TextBlock x:Name="FloorResultsSummary" DockPanel.Dock="Right" Foreground="DimGray"/></DockPanel>
                <DataGrid x:Name="FloorResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="FloorResultsGrid_SelectionChanged" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding ElementType}" Width="65"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding StoryOrLevel}" Width="110"/>
                        <DataGridTextColumn Header="Revit" Binding="{Binding RevitName}" Width="150"/>
                        <DataGridTextColumn Header="ETABS" Binding="{Binding EtabsName}" Width="150"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="145"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                        <DataGridTextColumn Header="ΔPos" Binding="{Binding PositionDeltaMm,StringFormat=F1}" Width="70"/>
                        <DataGridTextColumn Header="ΔElev" Binding="{Binding ElevationDeltaMm,StringFormat=F1}" Width="75"/>
                        <DataGridTextColumn Header="ΔW" Binding="{Binding WidthDeltaMm,StringFormat=F1}" Width="60"/>
                        <DataGridTextColumn Header="ΔD" Binding="{Binding DepthDeltaMm,StringFormat=F1}" Width="60"/>
                        <DataGridTextColumn Header="ΔL" Binding="{Binding LengthDeltaMm,StringFormat=F1}" Width="60"/>
                        <DataGridTextColumn Header="ΔRot" Binding="{Binding RotationDeltaDeg,StringFormat=F1}" Width="65"/>
                        <DataGridTextColumn Header="Conf." Binding="{Binding Confidence,StringFormat=F0}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6" x:Name="StatusText" Margin="0,7,0,0" Foreground="DarkSlateGray"/>
    </Grid>
</Window>
