<Window x:Class="RevitEtabsValidator.Revit.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RevitEtabsValidator.Revit.UI.Converters"
        Title="Revit ↔ ETABS Structural Model Validator"
        Height="920" Width="1500" MinHeight="760" MinWidth="1180"
        Background="#F3F5F8" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2455A4"/>
        <SolidColorBrush x:Key="BorderColorBrush" Color="#D8DDE2"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
        <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter"/>

        <!-- Buttons: one shared template (rounded, opacity-based hover/press feedback)
             with Primary (filled accent) and Secondary (outlined) skins on top. -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- TextBox: rounded, subtle border that highlights on focus. PART_ContentHost is
             required by the TextBox control model for the caret/text to render at all. -->
        <Style x:Key="ToleranceTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ResultsGridStyle" TargetType="DataGrid">
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style x:Key="StatusCellStyle" TargetType="DataGridCell">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StripeCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Stat tiles on the summary strip: white card + a thin colored left accent
             indicating whether the metric is neutral, good, or a problem to look at. -->
        <Style x:Key="StatTileStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Revit ↔ ETABS Structural Model Validator" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Structural coordination QA — Revit Internal Origin ↔ ETABS Global" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#F7F9FA" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="16" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="IndianRed" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="ConnectionStateText" Text="ETABS: Not connected" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Read Revit" Width="112" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ReadRevit_Click"/>
                <Button Content="Connect ETABS" Width="128" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ConnectEtabs_Click"/>
                <CheckBox x:Name="StartEtabs" Content="Start ETABS if not running" VerticalAlignment="Center" IsChecked="False" Margin="0,0,18,0" Foreground="{StaticResource TextMutedBrush}"/>
                <Rectangle Width="1" Fill="{StaticResource BorderColorBrush}" Margin="0,4,14,4"/>
                <Button Content="Run Validation" Width="132" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="RunValidation_Click"/>
                <Button Content="Validation Scope…" Width="140" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="SelectFloors_Click"/>
                <Rectangle Width="1" Fill="{StaticResource BorderColorBrush}" Margin="6,4,14,4"/>
                <Button Content="Export CSV" Width="104" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="ExportCsv_Click"/>
                <Button Content="Export JSON" Width="108" Style="{StaticResource SecondaryButtonStyle}" Click="ExportJson_Click"/>
            </StackPanel>
        </Border>

        <!-- Tolerances -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Position ±" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox x:Name="PositionTol" Text="25" Width="52" Grid.Column="1" Margin="6,0,14,0" Style="{StaticResource ToleranceTextBoxStyle}"/>
                <TextBlock Text="Elevation ±" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox x:Name="ElevationTol" Text="25" Width="52" Grid.Column="3" Margin="6,0,14,0" Style="{StaticResource ToleranceTextBoxStyle}"/>
                <TextBlock Text="Section ±" Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox x:Name="SectionTol" Text="5" Width="52" Grid.Column="5" Margin="6,0,14,0" Style="{StaticResource ToleranceTextBoxStyle}"/>
                <TextBlock Text="Length ±" Grid.Column="6" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox x:Name="LengthTol" Text="25" Width="52" Grid.Column="7" Margin="6,0,14,0" Style="{StaticResource ToleranceTextBoxStyle}"/>
                <TextBlock Text="Angle ±" Grid.Column="8" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox x:Name="AngleTol" Text="1" Width="52" Grid.Column="9" Margin="6,0,14,0" Style="{StaticResource ToleranceTextBoxStyle}"/>
                <TextBlock Text="mm / deg" Grid.Column="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <Border Grid.Column="11" Background="#EEF2F7" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="14" Padding="12,6">
                    <TextBlock x:Name="ScopeText" Text="Scope: all floors" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Summary tiles -->
        <UniformGrid Grid.Row="3" Rows="1" Columns="8" Margin="0,0,0,10">
            <Border Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" Margin="10,8,8,8">
                        <TextBlock Text="REVIT COLUMNS" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="RevitColCount" Text="0" Style="{StaticResource StatValueStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" Margin="10,8,8,8">
                        <TextBlock Text="ETABS COLUMNS" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="EtabsColCount" Text="0" Style="{StaticResource StatValueStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" Margin="10,8,8,8">
                        <TextBlock Text="REVIT BEAMS" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="RevitBeamCount" Text="0" Style="{StaticResource StatValueStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" Margin="10,8,8,8">
                        <TextBlock Text="ETABS BEAMS" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="EtabsBeamCount" Text="0" Style="{StaticResource StatValueStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource SuccessBrush}"/>
                    <StackPanel Grid.Column="1" Margin="10,8,8,8">
                        <TextBlock Text="MATCHED" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="MatchedCount" Text="0" Style="{StaticResource StatValueStyle}" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource WarningBrush}"/>
                    <StackPanel Grid.Column="1" Margin="10,8,8,8">
                        <TextBlock Text="WARNINGS" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="WarningCount" Text="0" Style="{StaticResource StatValueStyle}" Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatTileStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource DangerBrush}"/>
                    <StackPanel Grid.Column="1" Margin="10,8,8,8">
                        <TextBlock Text="ERRORS" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="ErrorCount" Text="0" Style="{StaticResource StatValueStyle}" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatTileStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource DangerBrush}"/>
                    <StackPanel Grid.Column="1" Margin="10,8,8,8">
                        <TextBlock Text="MISSING" Style="{StaticResource StatLabelStyle}"/>
                        <TextBlock x:Name="MissingCount" Text="0" Style="{StaticResource StatValueStyle}" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Floor plans / plan view / selected member -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="14" Grid.Column="0" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Floor Plans" Style="{StaticResource SectionHeaderStyle}"/>
                    <ListBox x:Name="PlanFloorList" Grid.Row="1" Margin="0,10,0,10" BorderThickness="1" BorderBrush="{StaticResource BorderColorBrush}" SelectionChanged="PlanFloorList_SelectionChanged"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Scope…" Width="90" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,0" Click="SelectFloors_Click"/>
                        <Button Content="Clear" Width="70" Style="{StaticResource CompactButtonStyle}" Click="ClearFloorView_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" ClipToBounds="True" x:Name="PlanViewHost">
                <Grid>
                    <Border Background="#F7F9FA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="9,6" CornerRadius="4" Panel.ZIndex="5">
                        <TextBlock Text="Wheel: zoom   •   Middle mouse: pan   •   Click member: details" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </Border>
                    <Canvas x:Name="PlanCanvas" Background="Transparent" MouseWheel="PlanCanvas_MouseWheel" MouseDown="PlanCanvas_MouseDown" MouseMove="PlanCanvas_MouseMove" MouseUp="PlanCanvas_MouseUp" SizeChanged="PlanCanvas_SizeChanged"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Panel.ZIndex="5">
                        <Button Content="Fit" Width="52" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,0" Click="FitPlan_Click"/>
                        <Button Content="−" Width="32" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,0" Click="ZoomOut_Click"/>
                        <Button Content="+" Width="32" Style="{StaticResource CompactButtonStyle}" Margin="0,0,6,0" Click="ZoomIn_Click"/>
                        <Border Background="White" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" Padding="9,5" CornerRadius="4"><TextBlock x:Name="ZoomText" Text="100%" FontSize="12"/></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Panel.ZIndex="5">
                        <Border Background="White" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="0,0,6,0"><TextBlock FontSize="12"><Run Text="Revit" FontWeight="Bold"/><Run Text="  ━"/></TextBlock></Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="0,0,6,0"><TextBlock FontSize="12"><Run Text="ETABS" FontWeight="Bold"/><Run Text="  ┄"/></TextBlock></Border>
                        <Border Background="White" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1" CornerRadius="4" Padding="9,6"><TextBlock FontSize="12" Foreground="{StaticResource DangerBrush}"><Run Text="Mismatch" FontWeight="Bold"/><Run Text="  red"/></TextBlock></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected Member" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border Background="#F7F9FA" BorderBrush="#DDE2E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,12"><StackPanel><TextBlock x:Name="SelectedTypeText" Text="—" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock x:Name="SelectedStatusText" Text="No member selected" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
                        <TextBlock Text="Correspondence" FontWeight="Bold" Margin="0,2,0,5" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SelectedRevitText" Text="Revit: —" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedEtabsText" Text="ETABS: —" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="Section" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SelectedSectionText" Text="Revit: —&#x0a;ETABS: —" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="Location" FontWeight="Bold" Margin="0,12,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SelectedLocationText" Text="Revit: —&#x0a;ETABS: —" TextWrapping="Wrap" Margin="0,3,0,0" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="Differences" FontWeight="Bold" Margin="0,12,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SelectedDeltaText" Text="—" TextWrapping="Wrap" Margin="0,3,0,0" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="Why?" FontWeight="Bold" Margin="0,12,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SelectedReasonText" Text="Select a beam or column in the plan." TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Open Details" Width="112" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OpenDetails_Click"/>
                            <Button Content="Select in Revit" Width="118" Style="{StaticResource PrimaryButtonStyle}" Click="SelectInRevit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Results grid -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="14,10,14,6">
                    <TextBlock Text="Current Floor Results" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock x:Name="FloorResultsSummary" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}"/>
                </DockPanel>
                <DataGrid x:Name="FloorResultsGrid" Grid.Row="1" Style="{StaticResource ResultsGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="FloorResultsGrid_SelectionChanged" Margin="6,0,6,6">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="6" CanUserResize="False" CanUserSort="False" CellStyle="{StaticResource StripeCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Rectangle Fill="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding ElementType}" Width="65"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding StoryOrLevel}" Width="110"/>
                        <DataGridTextColumn Header="Revit" Binding="{Binding RevitName}" Width="150"/>
                        <DataGridTextColumn Header="ETABS" Binding="{Binding EtabsName}" Width="150"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" CellStyle="{StaticResource StatusCellStyle}"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="75"/>
                        <DataGridTextColumn Header="ΔPos" Binding="{Binding PositionDeltaMm,StringFormat=F1}" Width="65"/>
                        <DataGridTextColumn Header="ΔElev" Binding="{Binding ElevationDeltaMm,StringFormat=F1}" Width="70"/>
                        <DataGridTextColumn Header="ΔW" Binding="{Binding WidthDeltaMm,StringFormat=F1}" Width="58"/>
                        <DataGridTextColumn Header="ΔD" Binding="{Binding DepthDeltaMm,StringFormat=F1}" Width="58"/>
                        <DataGridTextColumn Header="ΔL" Binding="{Binding LengthDeltaMm,StringFormat=F1}" Width="58"/>
                        <DataGridTextColumn Header="ΔRot" Binding="{Binding RotationDeltaDeg,StringFormat=F1}" Width="62"/>
                        <DataGridTextColumn Header="Conf." Binding="{Binding Confidence,StringFormat=F0}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6" x:Name="StatusText" Margin="2,8,0,0" Foreground="{StaticResource TextMutedBrush}"/>
    </Grid>
</Window>
